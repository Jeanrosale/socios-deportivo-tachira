# ARCHIVO: .env.example
# PAPEL: plantilla del .env SIN claves reales
# USO: copiar como .env y llenar los valores

# Puerto del servidor (localhost)
PORT=3000

# Correo que envia los mensajes (Gmail con contrasena de aplicacion)
GMAIL_USUARIO=
GMAIL_CLAVE_APLICACION=

# Inicio de los enlaces que llegan en los correos
URL_BASE=http://localhost:3000
